	ListView: Показать списком
	GridView: Показать сеткой
	GridViewDescription: Включён вид сеткой. Нажмите, чтобы переключиться на вид списком
	ListViewDescription: Включён вид списком. Нажмите, чтобы переключиться на вид сеткой
	Settings: Настройки

	Sort: {
		ID: по ID
		Alphabetical: по алфавиту
		Damage: по типу урона
		Defense: по защите
		Value: по цене
		Life: по максимальному здоровью
		CurrentLife: по текущему здоровью
		SessionTime: по времени в игре
		AlphabeticalPath: по алфавиту (путь)
		Teams: по команде
	}

	ButtonSizeSlider: {
		Name: Изменить масштаб
		Tooltip: Двигайте ползунок, чтобы изменить масштаб иконок в браузере.
	}
}

DraggableUIState: {
	Close: Закрыть

	UserGuide: {
		Name: Руководство
		Tooltip: Открыть руководство по использованию этого инструмента в браузере.
	}
}

EmergencyCustomizeMenu: {
	CustomizeToolbars: Кастомизировать
	CustomizeTools: Кастом.
}

FirstTimeLayoutPresetMenu: {
	Welcome: Добро пожаловать в DragonLens!
	SelectLayout: Пожалуйста, выберете шаблон для начала работы.
	Selected: Выбран шаблон «{0}»! Используйте инструмент кастомизации (иконка гаечного ключа) чтобы выбрать другой шаблон или кастомизировать текущий.
}

LayoutPresetBrowser: {
	Name: Предпросмотр шаблонов
	LoadedLayout: Выбранный шаблон: {0}
}

Layout: {
	Invalid: Сохранённый шаблон недействителен или повреждён!

	Simple: {
		Name: Упрощённый
		Tooltip: Упрощённый шаблон, идеально подходящий для игроков и тестировщиков модов.
	}

	Advanced: {
		Name: Продвинутый
		Tooltip: Продвинутый шаблон со всеми доступными инструментами. Идеально подходит для разработчиков модов и опытных пользователей.
	}

	HEROsMod: {
		Name: Стиль HERO's Mod
		Tooltip: Шаблон, пытающийся как можно точнее повторить HERO's мод.
	}

	Cheatsheet: {
		Name: Стиль Cheat Sheet
		Tooltip: Шаблон, пытающийся как можно точнее повторить Cheat Sheet.
	}

	Empty: {
		Name: Пустой
		Tooltip: Чистый лист для создания собственного шаблона.
	}
}

ToggleButton: {
	On: Вкл.
	Off: Выкл.
}

ToolbarCustomizationElements: {
	RemoveButton: {
		Name: Удалить инструмент
		Tooltip: Вы всегда можете вернуть его при помощи меню добавления инструментов (зелёная вкладка)!
	}

	AddButton: {
		Name: Добавить инструмент
		Tooltip: Нажмите, чтобы добавить инструменты на панель инструментов.
	}

	RemoveToolbarButton: {
		Name: Удалить панель инструментов
		Tooltip: Удаляет всю панель инструментов!
	}

	ToolbarDragger: {
		Name: Передвинуть панели инструментов
		Tooltip:
			'''
			Удерживайте и перетащите, чтобы изменить положение панели инструментов. Панель инструментов автоматически прикрепляется к краям экрана, если она находится к ним достаточно близко.
			Щелкните ПКМ при перетаскивании, чтобы повернуть панель инструментов.
			'''
	}

	ToolButtonDragger: {
		Name: Передвинуть инструмент
		Tooltip: Удерживайте и перетащите, чтобы изменить положение этого инструмента на панели инструментов.
	}

	HideOptionButton: {
		Name: Уровень скрытия: {0}
		Tooltip:
			'''
			Позволяет задать условия видимости для этой панели инструментов.
			{0}
			Нажатие переключит на: {1}
			'''

		Never: {
			Name: Обычный
			Tip: Видна всегда.
		}

		InventoryOpen: {
			Name: Только с закрытым инвентарём
			Tip: Видна только в том случае, если инвентарь закрыт
		}

		InventoryClosed: {
			Name: Только с открытым инвентарём
			Tip: Видна только в том случае, если инвентарь открыт
		}

		NoMapScreen: {
			Name: Только с открытой картой
			Tip:
				'''
				Видна только на карте.
				Примечание: инструменты, открывающие свои меню потребуют закрыть карту для использования!
				'''
		}
	}

	NewBarButton: {
		Name:
			'''
			Добавить панель
			инструментов
			'''
		Tooltip:
			'''
			Создайте новую пустую панель инструментов!


			'''
	}

	SaveLayoutButton: {
		Name:
			'''
			Сохранить
			и выйти
			'''
		Tooltip:
			'''
			Сохраняет шаблон и закрывает меню кастомизации.


			'''
		LayoutSaved: Шаблон сохранён!
	}

	LoadLayoutButton: {
		Name:
			'''
			Загрузить
			шаблон
			'''
		Tooltip:
			'''
			Загрузить существующий шаблон.


			'''
	}

	VisualConfigButton: {
		Name: Настроить тему
		Tooltip: Открывает меню настройки темы.
	}

	FunctionalConfigButton: {
		Name:
			'''
			Настройка
			инструментов
			'''
		Tooltip:
			'''
			Открывает конфигурацию для изменения функциональности/настроек инструментов.


			'''
	}
}

ThemeMenu.Name: Редактор тем

